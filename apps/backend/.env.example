# Salin ke .env lalu sesuaikan.  (.env TIDAK di-commit)

# HTTP
APP_ENV=development
HTTP_PORT=8080

# Database (samakan dengan docker-compose.dev.yml di root)
DATABASE_URL=postgres://questday:questday@localhost:5432/questday?sslmode=disable

# Auth
JWT_SECRET=ganti-dengan-secret-acak-panjang
JWT_TTL=24h

# CORS — origin frontend yang diizinkan (comma-separated). Kosong = CORS mati.
# mis. http://localhost:5173
CORS_ALLOWED_ORIGINS=
